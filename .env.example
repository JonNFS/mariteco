# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon/publishable). Pode ir para o navegador, a segurança vem das políticas RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave SECRETA (service_role). NUNCA use o prefixo NEXT_PUBLIC_ e nunca commite.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp só com números, com 55 + DDD (confira se o número tem 9 dígitos depois do DDD)
NEXT_PUBLIC_WHATSAPP=558296332203

# ---- Frete (estimativa por tabela; trocar por Melhor Envio/Correios depois) ----
STORE_ORIGIN_CEP=57081015
# Frete grátis (opção econômica) acima deste valor, em centavos. 0 = desativado.
FREE_SHIPPING_THRESHOLD_CENTS=29900

# ---- Mercado Pago (painel de desenvolvedores > Sua integração > Credenciais) ----
# Use as credenciais de TESTE primeiro. A chave pública pode ir ao navegador; o Access Token é SECRETO.
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# "Assinatura secreta" gerada ao configurar o webhook (Webhooks > Configurar notificações)
MP_WEBHOOK_SECRET=

# ---- Rotina diária que libera pedidos não pagos (Vercel Cron envia este segredo sozinho) ----
# Gere um valor longo e aleatório, ex.: openssl rand -hex 32
CRON_SECRET=

# ---- Avisos por e-mail (Resend: resend.com) ----
RESEND_API_KEY=
# Precisa ser de um domínio verificado no Resend. Ex.: Mariteco <pedidos@seudominio.com.br>
EMAIL_FROM=

# ---- Avisos automáticos por WhatsApp (Meta WhatsApp Cloud API) — opcional ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Nomes dos modelos (templates) APROVADOS na Meta, idioma pt_BR, 5 variáveis: {{1}} pedido {{2}} valor {{3}} produtos {{4}} entrega {{5}} previsão
WHATSAPP_TEMPLATE_ORDER_PAID=
WHATSAPP_TEMPLATE_ORDER_CREATED=
WHATSAPP_TEMPLATE_ORDER_SHIPPED=
